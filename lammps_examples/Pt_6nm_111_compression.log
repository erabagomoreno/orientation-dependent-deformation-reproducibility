#-------------------COMPRESSION------------------------------------

compute	force all reduce sum fz	# Add the forces of all atoms

variable zmax equal c_3[3]		# store the value for maximum z
variable zmin equal c_2[3]		#store value for minimum z

thermo_style custom step time temp etotal ke pe press lx ly lz vol c_2[1] c_2[2] c_2[3] c_3[1] c_3[2] c_3[3]

dump NPTmin all xyz 1 ${outdir}/Pt_6nm_shape.0.xyz
dump NPTmin all xyz 1 /home/erabagomoreno/data/nano_data/6nm_7_strainrate_20_strain_sims_correctwallseperation/Pt_6nm_111_r1/Pt_6nm_shape.0.xyz
run 0
