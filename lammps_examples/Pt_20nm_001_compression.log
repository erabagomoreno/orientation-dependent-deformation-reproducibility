undump NPTmin

# Per atom energy.
compute        peratom all pe/atom
compute		CSP all centro/atom fcc

# Per atom stress. [(stress) per (atom) per (unit of volume)] = [bar/atom/A3]
compute strAS1 all stress/atom NULL virial
# Per region stress. [Stress per (unit of volume)] = [bar/A3].
compute strAS2 all reduce sum c_strAS1[1] c_strAS1[2] c_strAS1[3] c_strAS1[4] c_strAS1[5] c_strAS1[6]

# Stress tensor [GPa].
variable Sxx equal (c_strAS2[1])
variable Syy equal (c_strAS2[2])
variable Szz equal (c_strAS2[3])
variable Sxy equal (c_strAS2[4])
variable Sxz equal (c_strAS2[5])
variable Syz equal (c_strAS2[6])

variable  hydro atom (c_strAS1[1]+c_strAS1[2]+c_strAS1[3])/3
variable S11 atom (c_strAS1[1]-v_hydro)
variable S22 atom (c_strAS1[2]-v_hydro)
variable S33 atom (c_strAS1[3]-v_hydro)

variable  vonmises2 atom (c_strAS1[1]-c_strAS1[2])^2+(c_strAS1[2]-c_strAS1[3])^2+(c_strAS1[1]-c_strAS1[3])^2+6*(c_strAS1[4]^2+c_strAS1[5]^2+c_strAS1[6]^2)

variable Xl equal (${zmax}-${zmin})
variable Xl equal (100.336876086493-${zmin})
variable Xl equal (100.336876086493--100.390169719848)
variable reducedsize equal ${Xl}*0.10           # maximum stress *2 two walls are been used
variable reducedsize equal 200.727045806341*0.10           

variable stn equal (-1*(c_3[3]-c_2[3]-${Xl})/${Xl})
variable stn equal (-1*(c_3[3]-c_2[3]-200.727045806341)/${Xl})
variable stn equal (-1*(c_3[3]-c_2[3]-200.727045806341)/200.727045806341)

variable intop equal (${zmax}+2.0)
variable intop equal (100.336876086493+2.0)
variable fintop equal (${zmax}-${reducedsize}+2.00)
variable fintop equal (100.336876086493-${reducedsize}+2.00)
variable fintop equal (100.336876086493-20.0727045806341+2.00)
variable inbot equal (${zmin}-2.0)
variable inbot equal (-100.390169719848-2.0)
variable finbot equal (${zmin}+${reducedsize}-2.00)
variable finbot equal (-100.390169719848+${reducedsize}-2.00)
variable finbot equal (-100.390169719848+20.0727045806341-2.00)

#----------------LOADING------------------------------------

fix 9 all langevin ${t} ${t} $(1000.0*dt) 84829
fix 9 all langevin 300 ${t} $(1000.0*dt) 84829
fix 9 all langevin 300 300 $(1000.0*dt) 84829
fix 9 all langevin 300 300 1 84829
fix		1 all nve

variable ramptop equal ramp(v_intop,v_fintop)
variable rampbot equal ramp(v_inbot,v_finbot)

fix indentertop all wall/harmonic zhi v_ramptop 500.0 1.0 1.8 units box
fix indenterbot all wall/harmonic zlo v_rampbot 500.0 1.0 1.8 units box
fix printforce all ave/time 5 200 5000 f_indentertop[1] f_indenterbot[1]
fix Sxxave all ave/time 5 200 5000 v_Sxx
fix Syyave all ave/time 5 200 5000 v_Syy
fix Szzave all ave/time 5 200 5000 v_Szz
fix Sxyave all ave/time 5 200 5000 v_Sxy
fix Sxzave all ave/time 5 200 5000 v_Sxz
fix Syzave all ave/time 5 200 5000 v_Syz

log	${outdir}/log.Pt_shape
log	/home/erabagomoreno/data/nano_data/20nm_7_strainrate_20_strain_sims_correctwallseperation/Pt_20nm_100_r1/log.Pt_shape
